{
  "schemaVersion": 1,
  "id": "dripleaf-finder",
  "version": "${version}",
  "name": "Dripleaf Finder",
  "description": "AUTISM addon that finds spliced small dripleaf, from the world or from the seed.",
  "environment": "*",
  "entrypoints": {
    "client": ["dripleaffinder.DripleafClient"],
    "main": ["dripleaffinder.Searcher"],
    "seedcrackerx": ["dripleaffinder.SeedcrackerLink"],
    "autism": ["dripleaffinder.autism.AutismFront"]
  },
  "depends": {
    "minecraft": "${mc}",
    "fabricloader": ">=0.15.0",
    "fabric-api-base": "*",
    "java": ">=${java}"
  }
}
